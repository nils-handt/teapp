#!/usr/bin/env bash
set -euo pipefail

real_adb="${ANDROID_HOME:?ANDROID_HOME must be set}/platform-tools/adb"

if [[ "${1:-}" == '-s' && "${2:-}" == emulator-* && "${3:-}" == 'shell' && "${4:-}" == 'input' && "${5:-}" == 'keyevent' && "${6:-}" == '82' ]]; then
  serial="$2"
  deadline=$((SECONDS + 120))
  stable_probes=0
  echo '[visual:android] waiting for Android services before the emulator unlock command' >&2

  while ((SECONDS < deadline)); do
    input_status=$("${real_adb}" -s "${serial}" shell service check input 2>/dev/null || true)
    activity_status=$("${real_adb}" -s "${serial}" shell service check activity 2>/dev/null || true)
    package_status=$("${real_adb}" -s "${serial}" shell service check package 2>/dev/null || true)

    if [[ "${input_status}" == *': found' && "${activity_status}" == *': found' && "${package_status}" == *': found' ]]; then
      stable_probes=$((stable_probes + 1))
      if ((stable_probes >= 3)); then
        break
      fi
    else
      stable_probes=0
    fi
    sleep 1
  done

  if ((stable_probes < 3)); then
    echo 'Timed out waiting for stable Android input, activity, and package services' >&2
    exit 1
  fi
fi

exec "${real_adb}" "$@"
